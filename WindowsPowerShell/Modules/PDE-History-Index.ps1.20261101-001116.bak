# 5. History index (newest first)
# ---------------------------------------------------------------------------

function global:Get-PDEFastHistoryCommandNames {
    [CmdletBinding()]
    param([Parameter(Mandatory)][AllowEmptyString()][string]$Line)

    # Bulk history import uses the legacy tokenizer, not full AST construction.
    # This extracts static command tokens in a single lexical pass.
    if ([string]::IsNullOrWhiteSpace($Line) -or $Line -match '[\r\n]') {
        return [pscustomobject]@{ IsValid = $false; CommandNames = @(); Reason = 'Empty or multi-line entry.' }
    }

    $tokenErrors = $null
    try {
        # PSParser.Tokenize returns the token collection and accepts one
        # by-reference error collection. No full AST is constructed here.
        $tokens = [System.Management.Automation.PSParser]::Tokenize(
            $Line,
            [ref]$tokenErrors
        )
    }
    catch {
        return [pscustomobject]@{ IsValid = $false; CommandNames = @(); Reason = $_.Exception.Message }
    }

    if ($tokenErrors -and $tokenErrors.Count -gt 0) {
        return [pscustomobject]@{ IsValid = $false; CommandNames = @(); Reason = 'Tokenizer reported errors.' }
    }

    $names = [System.Collections.Generic.List[string]]::new()
    $nameSet = [System.Collections.Generic.HashSet[string]]::new(
        [System.StringComparer]::OrdinalIgnoreCase
    )

    foreach ($token in $tokens) {
        if ([string]$token.Type -ne 'Command') { continue }

        $commandName = ([string]$token.Content).Trim()
        if ([string]::IsNullOrWhiteSpace($commandName)) { continue }

        $recognised = $global:PDE_State.CommandNames.Contains($commandName)
        if (-not $recognised) {
            try {
                $recognised = Test-Path -LiteralPath $commandName -PathType Leaf -ErrorAction SilentlyContinue
            }
            catch { $recognised = $false }
        }

        # Match the previous conservative import rule: reject a line if any
        # static command token cannot be resolved in this session.
        if (-not $recognised) {
            return [pscustomobject]@{
                IsValid = $false
                CommandNames = @()
                Reason = "Unrecognised command token: $commandName"
            }
        }

        if ($nameSet.Add($commandName)) { $names.Add($commandName) }
    }

    if ($names.Count -eq 0) {
        return [pscustomobject]@{ IsValid = $false; CommandNames = @(); Reason = 'No static command token found.' }
    }

    return [pscustomobject]@{
        IsValid = $true
        CommandNames = $names.ToArray()
        Reason = $null
    }
}

function global:Add-PDEHistoryIndexEntryFast {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$Line,
        [Parameter(Mandatory)][AllowEmptyCollection()][System.Collections.Generic.List[string]]$History,
        [Parameter(Mandatory)][AllowEmptyCollection()][System.Collections.Generic.HashSet[string]]$HistorySet,
        [Parameter(Mandatory)][int]$Limit
    )

    $cleanLine = $Line.Trim()
    if ([string]::IsNullOrWhiteSpace($cleanLine)) { return $false }
    if ($cleanLine -match '[\r\n]') { return $false }
    if (Test-PDESensitiveHistoryLine -Line $cleanLine) { return $false }
    if ($History.Count -ge $Limit) { return $false }

    $parsed = Get-PDEFastHistoryCommandNames -Line $cleanLine
    if (-not $parsed.IsValid) { return $false }
    if (-not $HistorySet.Add($cleanLine)) { return $false }

    # Appending while traversing newest-to-oldest is O(1) per accepted entry.
    # No List.Insert(0, ...) or Sort-Object pipeline is used during import.
    $History.Add($cleanLine)
    foreach ($commandName in $parsed.CommandNames) {
        Add-PDEHistoryCommandName -Name $commandName
    }

    return $true
}

function global:Update-PDEHistory {
    [CmdletBinding()]
    param()

    $global:PDE_State.History.Clear()
    $global:PDE_State.HistorySet.Clear()

    if (-not $global:PDE_State.HistoryCommandNames) {
        $global:PDE_State.HistoryCommandNames = [System.Collections.Generic.HashSet[string]]::new(
            [System.StringComparer]::OrdinalIgnoreCase
        )
    }
    else {
        $global:PDE_State.HistoryCommandNames.Clear()
    }

    if (-not $global:PDE_State.HistoryCommandPrefixes) {
        $global:PDE_State.HistoryCommandPrefixes = [System.Collections.Generic.HashSet[string]]::new(
            [System.StringComparer]::OrdinalIgnoreCase
        )
    }
    else {
        $global:PDE_State.HistoryCommandPrefixes.Clear()
    }

    $limit = [int]$global:PDE_Config.HistoryIndexLimit
    if ($limit -lt 1) { $limit = 1 }

    # Get-History is chronological. Add current-session items newest-first,
    # then saved-file items newest-first, sharing one ordinal line set.
    # This keeps the final list newest-first and makes import O(N).
    try {
        $sessionItems = @(Get-History -ErrorAction SilentlyContinue)
        for ($i = $sessionItems.Count - 1; $i -ge 0; $i--) {
            $line = [string]$sessionItems[$i].CommandLine
            if ($line) {
                [void](Add-PDEHistoryIndexEntryFast -Line $line `
                    -History $global:PDE_State.History `
                    -HistorySet $global:PDE_State.HistorySet `
                    -Limit $limit)
            }
            if ($global:PDE_State.History.Count -ge $limit) { break }
        }
    }
    catch {
        Write-PDELog -Level WARN -Message ("Could not read current-session history: {0}" -f $_.Exception.Message)
    }

    $historyPath = $null
    try {
        $historyPath = (Get-PSReadLineOption).HistorySavePath
        if ($historyPath -and (Test-Path -LiteralPath $historyPath -PathType Leaf)) {
            $remaining = $limit - $global:PDE_State.History.Count
            if ($remaining -gt 0) {
                $savedLines = @(Get-Content -LiteralPath $historyPath -Tail $limit -ErrorAction Stop)
                for ($i = $savedLines.Count - 1; $i -ge 0; $i--) {
                    [void](Add-PDEHistoryIndexEntryFast -Line ([string]$savedLines[$i]) `
                        -History $global:PDE_State.History `
                        -HistorySet $global:PDE_State.HistorySet `
                        -Limit $limit)
                    if ($global:PDE_State.History.Count -ge $limit) { break }
                }
            }
        }
    }
    catch {
        Write-PDELog -Level WARN -Message ("Could not read PSReadLine history file: {0}" -f $_.Exception.Message)
    }

    $global:PDE_State.LastHistoryUpdate = Get-Date

    [pscustomobject]@{
        Entries = $global:PDE_State.History.Count
        IndexedCommandNames = $global:PDE_State.HistoryCommandNames.Count
        Order = 'Newest first'
        Updated = $global:PDE_State.LastHistoryUpdate
        HistoryPath = $historyPath
    }
}

